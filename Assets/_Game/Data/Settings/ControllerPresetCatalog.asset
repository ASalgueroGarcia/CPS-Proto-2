%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c69320ad46fe4b5abb795d431f2a86e3, type: 3}
  m_Name: ControllerPresetCatalog
  m_EditorClassIdentifier: Spectracle.Core::ControllerPresetCatalog
  presets:
  - id: classic
    displayName: Classic (GDD)
    description: Standard GDD face-button layout.
    bindings:
    - actionName: Attack
      bindingPath: <Gamepad>/buttonSouth
      displayLabel: Normal Attack
    - actionName: Special
      bindingPath: <Gamepad>/buttonNorth
      displayLabel: Special Attack
    - actionName: Dash
      bindingPath: <Gamepad>/buttonEast
      displayLabel: Dash
    - actionName: Interact
      bindingPath: <Gamepad>/buttonWest
      displayLabel: Interact
    - actionName: Pause
      bindingPath: <Gamepad>/start
      displayLabel: Pause
  - id: action
    displayName: Action (Shoulders)
    description: Shoulder-focused combat layout keeping thumbs on sticks.
    bindings:
    - actionName: Attack
      bindingPath: <Gamepad>/buttonWest
      displayLabel: Normal Attack
    - actionName: Special
      bindingPath: <Gamepad>/rightTrigger
      displayLabel: Special Attack
    - actionName: Dash
      bindingPath: <Gamepad>/rightShoulder
      displayLabel: Dash
    - actionName: Interact
      bindingPath: <Gamepad>/buttonSouth
      displayLabel: Interact
    - actionName: Pause
      bindingPath: <Gamepad>/start
      displayLabel: Pause
